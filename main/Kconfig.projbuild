menu "OpelXID Configuration"
    config OPX_DEVICE_NAME
        string "BLE device name"
        default "OpelXID"
        help
            Public GAP device name advertised to the phone app.

    config OPX_RX_QUEUE_DEPTH
        int "RX queue depth"
        default 16
        range 4 64
        help
            Number of BLE write chunks buffered between NimBLE callbacks and protocol task.
endmenu
